{
  "manifest_version": 2,
  "name": "G2 probe bridge",
  "version": "1.0",
  "description": "Gives test pages the Even Hub bridge (flutter_inappwebview.callHandler) and reports the page layout for the render test.",
  "browser_specific_settings": {
    "gecko": { "id": "g2probe@madtreasures.ch" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-layout.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
