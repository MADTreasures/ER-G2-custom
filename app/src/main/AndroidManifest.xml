<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Keeps the glasses session alive while the watch screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Downloads Even's stock firmware (4.5 MB) from Even's CDN, and HTTPS requests of watch apps
         that have the "network" permission (AppContext.fetch). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Videos and the apps' downloads ask Wear OS for WLAN or LTE instead of the Bluetooth link through
         the phone (apps/video/FastNetwork.kt, apps/files/WearNetworkConnector.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- The watch's microphone for apps that stream it to an app on the phone (interface 4,
         AppContext.phone); asked for when the first such app wants it. With the screen dark only
         through the foreground service's type "microphone". -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The watch's GPS for apps with the "location" permission (interface 5, Sensor.LOCATION); asked
         for when the first such app subscribes. With the screen dark only through the foreground
         service's type "location". -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Music on the watch for apps (03 §15, interface 6): the players to open, and their names. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
    </queries>

    <application
        android:name=".G2WatchApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.G2Watch">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Runs without a paired phone app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- A Bluetooth keyboard coming or going changes the configuration; the activity stays (03 §5.4). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".glasses.GlassesService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone|location" />

        <!-- The key to the watch's media controls (03 §15): the wearer allows it once as notification access.
             It reads no notifications. -->
        <service
            android:name=".apps.media.MediaAccessService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Keeps the watch awake while firmware is prepared and transferred. -->
        <service
            android:name=".firmware.FirmwareService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
