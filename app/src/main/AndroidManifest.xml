<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Keeps the glasses session alive while the watch screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Downloads Even's stock firmware (4.5 MB) from Even's CDN, and HTTPS requests of watch apps
         that have the "network" permission (AppContext.fetch). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".G2WatchApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.G2Watch">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Runs without a paired phone app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".glasses.GlassesService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Keeps the watch awake while firmware is prepared and transferred. -->
        <service
            android:name=".firmware.FirmwareService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
