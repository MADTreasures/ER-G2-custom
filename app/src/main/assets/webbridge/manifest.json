{
  "manifest_version": 2,
  "name": "G2 Watch browser",
  "version": "1.0",
  "description": "Reports the page layout for the glasses, scrolls, types into fields and shows articles in reading mode.",
  "browser_specific_settings": {
    "gecko": { "id": "g2web@madtreasures.ch" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["readability/Readability-readerable.js", "readability/Readability.js", "page-layout.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
